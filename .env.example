# Client (inlined at build time, safe to expose)
# Devnet RPC the browser uses for coupon_vault transactions and balance reads.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Optional: inline JSON deployment (cluster, programs, usdcMint, markets[]) to override
# src/lib/vault/deployment.devnet.json, for a redeploy or a local validator.
# NEXT_PUBLIC_COUPON_DEPLOYMENT=

# Server only
# Mainnet RPC for read only multiplier and holdings reads (api.mainnet-beta is the fallback).
# SOLANA_RPC=https://solana-rpc.publicnode.com
# Optional Pyth Hermes key for live Pyth prices (pyth.dourolabs.app). Without it the app
# shows the Pyth onchain price account with its last update time.
# PYTH_API_KEY=
# PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes/v2/updates/price/latest
# Optional cache dir for last good chain reads. Defaults to /tmp on Vercel.
# COUPON_CACHE_DIR=/tmp

# Keeper (server only). Vercel cron calls /api/keeper with `Authorization: Bearer $CRON_SECRET`.
# CRON_SECRET=
# Admin keypair as a JSON byte array. Without it the keeper only reports what it would bump.
# COUPON_ADMIN_KEY=
# Devnet RPC for keeper transactions (defaults to NEXT_PUBLIC_SOLANA_RPC).
# KEEPER_RPC=
